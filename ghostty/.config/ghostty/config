# Luna palette based on https://github.com/WTFox/luna.nvim

font-family = "GeistMono Nerd Font Mono"
font-size = 12

background = #060606
foreground = #e4e4e8

cursor-color = #e4e4e8
cursor-text = #060606

selection-foreground = #e4e4e8
selection-background = #404040

palette = 0=#000000
palette = 1=#e08585
palette = 2=#6fbe80
palette = 3=#c2916a
palette = 4=#75a1c7
palette = 5=#c4a8d6
palette = 6=#75a1c7
palette = 7=#c7c7c7
palette = 8=#888888
palette = 9=#e08585
palette = 10=#6fbe80
palette = 11=#d9a35a
palette = 12=#8c9cb8
palette = 13=#c4a8d6
palette = 14=#75a1c7
palette = 15=#ffffff
palette = 16=#a8a8a8
palette = 17=#c2916a
palette = 18=#1c1c1c
palette = 19=#404040
palette = 20=#888888
palette = 21=#c7c7c7

background-opacity = 1
background-blur = false

# Ghostty defaults discrete mouse wheels to 3x speed.
mouse-scroll-multiplier = precision:1,discrete:1

keybind = cmd+up=increase_font_size:1
keybind = cmd+down=decrease_font_size:1
