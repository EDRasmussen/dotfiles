# Catppuccin Mocha, coordinated with Neovim and Herdr

font-family = "Lilex"
font-style = Regular
font-size = 13
window-padding-x = 14
window-padding-y = 14
window-theme = ghostty
resize-overlay = never

theme = Catppuccin Mocha

background-opacity = 1
background-blur = false

mouse-scroll-multiplier = 1

keybind = cmd+up=increase_font_size:1
keybind = cmd+down=decrease_font_size:1
