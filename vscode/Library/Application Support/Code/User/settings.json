{
  // Keep VSCodeVim responsible for modal editing and VS Code responsible for IDE features.
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.surround": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 170,
  "vim.foldfix": true,
  "vim.cursorStylePerMode.insert": "block",
  // mini.surround uses sa/sd/sr instead of VSCodeVim's ys/ds/cs defaults.
  "vim.normalModeKeyBindings": [
    {
      "before": [
        "s",
        "a"
      ],
      "after": [
        "y",
        "s"
      ]
    },
    {
      "before": [
        "s",
        "d"
      ],
      "after": [
        "d",
        "s"
      ]
    },
    {
      "before": [
        "s",
        "r"
      ],
      "after": [
        "c",
        "s"
      ]
    }
  ],
  // Match the core editing preferences in the Neovim configuration.
  "editor.lineNumbers": "relative",
  "editor.cursorStyle": "block",
  "editor.cursorSurroundingLines": 8,
  "editor.wordWrap": "off",
  "editor.renderWhitespace": "all",
  "editor.rulers": [
    100
  ],
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": true,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
