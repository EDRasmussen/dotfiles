#!/usr/bin/env bash

# Add standalone folders that do not live directly under ~/projects here.
custom_folders=(
    "$HOME/dotfiles"
)

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(
        {
            find "$HOME/projects" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
            for folder in "${custom_folders[@]}"; do
                [[ -d $folder ]] && printf '%s\n' "$folder"
            done
        } | awk '!seen[$0]++' | fzf
    )
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected=${selected/#\~/$HOME}

if [[ ! -d $selected ]]; then
    printf 'herdr-s: directory does not exist: %s\n' "$selected" >&2
    exit 1
fi

selected=$(cd "$selected" && pwd -P)
selected_name=$(basename "$selected" | tr . _)

# When the server is already running, switch to the matching workspace or
# create it. Workspace labels serve the same role as tmux session names.
if herdr status server >/dev/null 2>&1; then
    workspace_id=$(
        herdr workspace list 2>/dev/null |
            jq -r --arg label "$selected_name" \
                '.result.workspaces[] | select(.label == $label) | .workspace_id' |
            head -n 1
    )

    if [[ -n $workspace_id ]]; then
        herdr workspace focus "$workspace_id" >/dev/null
    else
        herdr workspace create --cwd "$selected" --label "$selected_name" --focus >/dev/null
    fi

    # From a regular terminal, attach after selecting the workspace. Inside
    # Herdr, the API call above is all that is needed.
    if [[ -z $HERDR_ENV ]]; then
        exec herdr
    fi
    exit 0
fi

# With no server yet, Herdr creates its initial workspace from this directory.
cd "$selected" || exit 1
exec herdr
